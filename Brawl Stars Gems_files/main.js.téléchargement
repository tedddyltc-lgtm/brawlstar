document.addEventListener('DOMContentLoaded', function () {
	function randomRange(min, max) {
		return Math.floor(Math.random() * (max - min + 1)) + min;
	}
	function createItem() {
		const container = document.querySelector('.container-item');
		const item = document.createElement('img');
		item.src = 'img//favicon.png';
		item.className = 'item';
		const containerWidth = container.offsetWidth;
		const containerHeight = container.offsetHeight;
		const side = randomRange(1, 4);
		let posX, posY;
		switch (side) {
			case 1:
				posX = randomRange(0, containerWidth - 100);
				posY = -100;
				break;
			case 2:
				posX = containerWidth;
				posY = randomRange(0, containerHeight - 100);
				break;
			case 3:
				posX = randomRange(0, containerWidth - 100);
				posY = containerHeight;
				break;
			case 4:
				posX = -100;
				posY = randomRange(0, containerHeight - 100);
				break;
			default:
				posX = randomRange(0, containerWidth - 100);
				posY = -100;
		}
		item.style.left = `${posX}px`;
		item.style.top = `${posY}px`;
		container.appendChild(item);
		item.style.opacity = '0';
		function animate() {
			const pos2X = randomRange(0, containerWidth - item.offsetWidth);
			const pos2Y = randomRange(0, containerHeight - item.offsetHeight);
			const duration = randomRange(3000, 7000);
			const opacityDuration = 500;
			item.style.transform = `translate(${posX}px, ${posY}px)`;
			item.style.opacity = '1';
			item.style.transitionDuration = `${opacityDuration}ms`;
			item.classList.add('animate');
			item.style.transform = `translate(${pos2X}px, ${pos2Y}px)`;
			item.style.transitionDuration = `${duration}ms`;
			setTimeout(() => {
				item.classList.add("fade-out1");
				setTimeout(function () {
					item.classList.remove('animate');
					item.style.transform = '';
					item.style.transitionDuration = '';
					item.classList.remove("fade-out1");
				}, 500);
			}, duration);
			const delay = randomRange(1000, 5000);
			setTimeout(animate, delay);
		}
		animate();
	}
	const numItems = 8;
	for (let i = 0; i < numItems; i++) {
		createItem();
	}
});
